<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SOLIDWORKS add-in (COM visible, .NET Framework 4.8, x64).
    By default the SOLIDWORKS interop assemblies come from NuGet (SOLIDWORKS 2024 API, works with older
    and newer versions because the COM interfaces only ever grow). To compile against your own installation instead:
      dotnet build -p:SolidWorksInteropDir="C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MeshFit.SolidWorks</RootNamespace>
    <AssemblyName>MeshFit.SolidWorks</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ComVisible>false</ComVisible>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshFit.Core\MeshFit.Core.csproj" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <None Include="Install\*.bat" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SolidWorksInteropDir)' == ''">
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="32.1.0" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="32.1.0" />
    <PackageReference Include="SolidWorks.Interop.swpublished" Version="32.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(SolidWorksInteropDir)' != ''">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
